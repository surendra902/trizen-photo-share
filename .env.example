# Database: SQLite for local dev; PostgreSQL for production (e.g. Neon)
DATABASE_URL="file:./dev.db"
# For production Neon PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="replace_with_a_secure_random_string_at_least_32_characters"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Driver: "local" (default offline) or "s3" (AWS S3 / Cloudflare R2)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Cloud Storage Credentials (Required if STORAGE_DRIVER="s3")
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
# S3_BUCKET="your-bucket-name"
# AWS_REGION="us-east-1"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com" # For Cloudflare R2
