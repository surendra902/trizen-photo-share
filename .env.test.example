# Copy this file to .env.test and fill in a throwaway test database URL.
# `npm test` runs against this database and WIPES its contents on every run —
# never point it at your demo/production database.
#
# Easiest: on Neon, create a second database (e.g. trizen_test) in the same
# project and paste its connection string below.
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/trizen_test?sslmode=require"
JWT_SECRET="test-only-jwt-secret-32-chars-min-length"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
